@{
    ViewBag.Title = "Error";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="card shadow-sm login-card text-center">
    <div class="card-body p-5">
        <i class="bi bi-exclamation-octagon-fill text-danger" style="font-size:3rem;"></i>
        <h3 class="mt-3">Something went wrong</h3>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>
        <a class="btn btn-primary mt-2" href="@Url.Action("Index", "Dashboard")">Back to Dashboard</a>
    </div>
</div>
