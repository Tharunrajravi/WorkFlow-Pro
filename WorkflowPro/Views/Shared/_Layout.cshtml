<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - WorkflowPro</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css")" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark topbar fixed-top">
        <div class="container-fluid">
            <button class="btn btn-link text-white d-md-none" id="sidebarToggle" type="button">
                <i class="bi bi-list fs-4"></i>
            </button>
            <a class="navbar-brand fw-semibold" href="@Url.Action("Index", "Dashboard")">
                <i class="bi bi-diagram-3-fill me-2"></i>WorkflowPro
            </a>
            <div class="ms-auto d-flex align-items-center">
                @if (Request.IsAuthenticated)
                {
                    <span class="text-white-50 me-3 d-none d-sm-inline">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                    </span>
                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    }
                }
            </div>
        </div>
    </nav>

    @if (Request.IsAuthenticated)
    {
        <div class="d-flex app-shell">
            <aside class="sidebar bg-dark" id="sidebar">
                <ul class="nav flex-column pt-3">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Dashboard" ? "active" : "")" href="@Url.Action("Index", "Dashboard")">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Department" ? "active" : "")" href="@Url.Action("Index", "Department")">
                            <i class="bi bi-building me-2"></i>Departments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Employee" ? "active" : "")" href="@Url.Action("Index", "Employee")">
                            <i class="bi bi-people-fill me-2"></i>Employees
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Document" ? "active" : "")" href="@Url.Action("Index", "Document")">
                            <i class="bi bi-file-earmark-text-fill me-2"></i>Documents
                        </a>
                    </li>
                </ul>
            </aside>

            <main class="content flex-grow-1">
                <div class="container-fluid py-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <main class="pt-5 mt-4">
            <div class="container-fluid py-4">
                @RenderBody()
            </div>
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('show');
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
