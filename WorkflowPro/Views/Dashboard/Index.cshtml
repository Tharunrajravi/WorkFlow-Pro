@model WorkflowPro.Models.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}

<div class="mb-4">
    <h3 class="fw-bold mb-1">Welcome back, @Model.WelcomeName!</h3>
    <p class="text-muted mb-0">Here's what's happening across WorkflowPro today.</p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card stat-card bg-employees">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small opacity-75">Total Employees</div>
                    <div class="fs-2 fw-bold">@Model.TotalEmployees</div>
                </div>
                <i class="bi bi-people-fill stat-icon"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a href="@Url.Action("Index", "Employee")" class="text-white text-decoration-none small">
                    View employees <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card bg-departments">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small opacity-75">Total Departments</div>
                    <div class="fs-2 fw-bold">@Model.TotalDepartments</div>
                </div>
                <i class="bi bi-building stat-icon"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a href="@Url.Action("Index", "Department")" class="text-white text-decoration-none small">
                    View departments <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card bg-documents">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-uppercase small opacity-75">Total Documents</div>
                    <div class="fs-2 fw-bold">@Model.TotalDocuments</div>
                </div>
                <i class="bi bi-file-earmark-text-fill stat-icon"></i>
            </div>
            <div class="card-footer bg-transparent border-0 pb-3">
                <a href="@Url.Action("Index", "Document")" class="text-white text-decoration-none small">
                    View documents <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
