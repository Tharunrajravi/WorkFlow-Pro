@model IEnumerable<WorkflowPro.Models.Department>
@{
    ViewBag.Title = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-building me-2"></i>Departments</h4>
    @if (User.IsInRole("Admin"))
    {
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Department</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Department", FormMethod.Get, new { @class = "row g-2" }))
        {
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by department name..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Department Name</th>
                    <th>Description</th>
                    <th>Created On</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No departments found.</td></tr>
                }
                @foreach (var dept in Model)
                {
                    <tr>
                        <td class="fw-semibold">@dept.DepartmentName</td>
                        <td>@dept.Description</td>
                        <td>@dept.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a href="@Url.Action("Details", new { id = dept.DepartmentId })" class="btn btn-sm btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Edit", new { id = dept.DepartmentId })" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a href="@Url.Action("Delete", new { id = dept.DepartmentId })" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
