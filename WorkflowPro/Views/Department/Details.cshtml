@model WorkflowPro.Models.Department
@{
    ViewBag.Title = "Department Details";
}

<h4 class="fw-bold mb-3"><i class="bi bi-building me-2"></i>Department Details</h4>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Department Name</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToString("dd MMM yyyy")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        @if (User.IsInRole("Admin"))
        {
            <a href="@Url.Action("Edit", new { id = Model.DepartmentId })" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        }
    </div>
</div>
