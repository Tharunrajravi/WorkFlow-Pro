@model WorkflowPro.Models.Department
@{
    ViewBag.Title = "Edit Department";
}

<h4 class="fw-bold mb-3"><i class="bi bi-pencil me-2"></i>Edit Department</h4>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "Department", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.DepartmentId)
            @Html.HiddenFor(m => m.CreatedDate)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.DepartmentName, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.DepartmentName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DepartmentName, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3 })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
        }
    </div>
</div>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
}
