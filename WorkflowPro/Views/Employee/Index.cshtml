@model IEnumerable<WorkflowPro.Models.Employee>
@{
    ViewBag.Title = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-people-fill me-2"></i>Employees</h4>
    @if (User.IsInRole("Admin"))
    {
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Employee</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        @using (Html.BeginForm("Index", "Employee", FormMethod.Get, new { @class = "row g-2" }))
        {
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, code or email..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Email</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No employees found.</td></tr>
                }
                @foreach (var emp in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(emp.ProfilePhotoPath))
                            {
                                <img src="@Url.Content("~/Uploads/Employees/" + emp.ProfilePhotoPath)" class="avatar-thumb" alt="@emp.FullName" />
                            }
                            else
                            {
                                <div class="avatar-thumb bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-person-fill text-secondary"></i>
                                </div>
                            }
                        </td>
                        <td>@emp.EmployeeCode</td>
                        <td class="fw-semibold">@emp.FullName</td>
                        <td>@emp.Department?.DepartmentName</td>
                        <td>@emp.Designation</td>
                        <td>@emp.Email</td>
                        <td class="text-end">
                            <a href="@Url.Action("Details", new { id = emp.EmployeeId })" class="btn btn-sm btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Edit", new { id = emp.EmployeeId })" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                <a href="@Url.Action("Delete", new { id = emp.EmployeeId })" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
