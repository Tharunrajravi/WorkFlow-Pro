@model WorkflowPro.Models.Employee
@{
    ViewBag.Title = "Employee Details";
}

<h4 class="fw-bold mb-3"><i class="bi bi-person-badge me-2"></i>Employee Details</h4>

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
                {
                    <img src="@Url.Content("~/Uploads/Employees/" + Model.ProfilePhotoPath)" class="avatar-thumb-lg" alt="@Model.FullName" />
                }
                else
                {
                    <div class="avatar-thumb-lg bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center mx-auto">
                        <i class="bi bi-person-fill text-secondary" style="font-size:3rem;"></i>
                    </div>
                }
                <h5 class="mt-3 mb-0">@Model.FullName</h5>
                <span class="text-muted">@Model.Designation</span>
            </div>
            <div class="col-md-9">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Employee Code</dt>
                    <dd class="col-sm-8">@Model.EmployeeCode</dd>

                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@Model.Department?.DepartmentName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd>

                    <dt class="col-sm-4">Salary</dt>
                    <dd class="col-sm-8">@Model.Salary.ToString("C")</dd>

                    <dt class="col-sm-4">Joined On</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="card-footer bg-white">
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        @if (User.IsInRole("Admin"))
        {
            <a href="@Url.Action("Edit", new { id = Model.EmployeeId })" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        }
    </div>
</div>
